# ---------------------------------------------------------------------------
# Copy to .env (git-ignored). Never commit real values.
# docs/enquiry-automation.md explains where each value comes from.
# ---------------------------------------------------------------------------

# Safety switch. Anything other than "production" is test mode: short timers,
# a separate "[test]" automation, and email only to *@resend.dev and the
# allowlist below. Set "production" on the live deployment only.
EMAIL_AUTOMATION_ENV=test
TEST_RECIPIENT_ALLOWLIST=you@baagul.in
# Length of each wait in test mode.
RESEND_TEST_STEP_DELAY=5 minutes

# --- Resend ----------------------------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Shown on the webhook's page in the Resend dashboard.
RESEND_WEBHOOK_SECRET=whsec_your_signing_secret
# Printed by `npm run automation -- create`.
RESEND_AUTOMATION_ID=
# Printed by `npm run templates -- sync`.
RESEND_TEMPLATE_CONFIRMATION_ID=
RESEND_TEMPLATE_INFORMATION_ID=
RESEND_TEMPLATE_FOLLOWUP_ID=
RESEND_TEMPLATE_FINAL_ID=
# Must be on a domain verified in Resend.
RESEND_FROM_EMAIL=hello@mail.baagul.in
# Must be on a Resend receiving domain for automatic reply detection.
RESEND_REPLY_TO_EMAIL=replies@reply.baagul.in
# Where received replies are forwarded. Defaults to CONTACT_RECEIVER_EMAIL.
RESEND_INBOUND_FORWARD_TO=support@baagul.in

# --- Company details used in emails ----------------------------------------
COMPANY_NAME=Baagul
COMPANY_WEBSITE_URL=https://www.baagul.in
COMPANY_PHONE=+91 7483737014
COMPANY_ADDRESS=Hustlehub Tech Park, HSR Layout, Bengaluru

# --- Team notifications ----------------------------------------------------
# The email address where the team receives new enquiry notifications
CONTACT_RECEIVER_EMAIL=support@baagul.in
# Used if Resend refuses delivery because the sending domain is unverified.
CONTACT_FALLBACK_EMAIL=praveen@baagul.com
# Older name for the sender. RESEND_FROM_EMAIL takes precedence.
# CONTACT_SENDER_EMAIL=onboarding@resend.dev

# --- Database (MySQL with Prisma) ------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Local MySQL example: mysql://root:password@localhost:3306/baagul
# Cloud MySQL (AWS RDS, PlanetScale, Railway, TiDB): mysql://user:password@host:3306/baagul?ssl={"rejectUnauthorized":true}
DATABASE_URL=mysql://root:password@localhost:3306/baagul

# --- Secrets you generate --------------------------------------------------
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Bearer token for /api/admin/enquiries*. Unset means those routes deny everyone.
ADMIN_API_TOKEN=
# Bearer token for /api/cron/enquiries. Unset means that route denies everyone.
CRON_SECRET=
# Salt for hashing IP addresses and emails in rate-limit keys.
RATE_LIMIT_SALT=
